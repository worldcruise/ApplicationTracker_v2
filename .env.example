# Copy apps/web/.env.example to apps/web/.env.local for the web app.
# The current shells build without credentials. These are future integration slots.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never add NEXT_PUBLIC_ or copy this value into the extension.
SUPABASE_SERVICE_ROLE_KEY=
