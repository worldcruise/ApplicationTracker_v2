# Copy apps/web/.env.example to apps/web/.env.local for the web app.
# Builds/checks need no connection; hosted web requests use the app's local public settings.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never add NEXT_PUBLIC_ or copy this value into the extension.
SUPABASE_SERVICE_ROLE_KEY=
