{
  "manifest_version": 3,
  "name": "Application Tracker v2",
  "version": "0.1.0",
  "description": "Candidate resume and profile workspace.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "downloads",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "action": {
    "default_title": "Open candidate workspace"
  },
  "commands": {
    "check-application-history": {
      "suggested_key": { "default": "Ctrl+Shift+F" },
      "description": "Check Application History"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
