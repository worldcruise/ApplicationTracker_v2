# Copy to .env.local on a fresh clone; hosted web requests require these public settings.
# Builds and offline checks do not need a connection. Keep project values out of this example.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: server-only Auth invitations and operator bootstrap. Never used for normal queries.
# Never add NEXT_PUBLIC_ or expose this to the extension. See docs/FOUNDATION.md.
SUPABASE_SERVICE_ROLE_KEY=
# Optional development-only extension identity probe. Production always returns 404.
FEASIBILITY_API_ENABLED=false
EXTENSION_ALLOWED_ORIGIN=
